# BAC Expense Tracker - Environment Variables

# Directorio de configuración (credenciales)
CONFIG_DIR=/app/config

# Directorio de datos (expenses.json)
DATA_DIR=/app/data

# Zona horaria
TZ=America/El_Salvador

# Configuración de sincronización (solo producción)
SYNC_HOUR=7
SYNC_MINUTE=0

# Días a sincronizar (desde hoy hacia atrás)
SYNC_DAYS=30

# Banco a rastrear
BANK=BAC

# Email del banco (patrón de búsqueda)
BANK_EMAIL=notificaciones@bac.com.sv

# Puerto del dashboard
DASHBOARD_PORT=8080

# Base de datos (opcional)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=expense_tracker
# DB_USER=tracker
# DB_PASSWORD=changeme

# Notificaciones (opcional)
# WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# EMAIL_NOTIFICATIONS=false
# ALERT_THRESHOLD=500  # Alerta si gastos diarios > esto
