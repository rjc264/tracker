# BAC Expense Tracker - Variables de entorno
#
# Estas variables se usan localmente (para pruebas) y como GitHub Actions
# "repository variables" (Settings > Secrets and variables > Actions > Variables).
# Las credenciales de Gmail NO van aquí: se guardan como Secrets (ver README.md).

# Días a sincronizar (desde hoy hacia atrás)
SYNC_DAYS=30

# Banco a rastrear
BANK=BAC

# Email del banco (patrón de búsqueda)
BANK_EMAIL=notificaciones@bac.com.sv
